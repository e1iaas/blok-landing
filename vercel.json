{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.blokapp.app"
        }
      ],
      "destination": "https://blokapp.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blokapp.vercel.app"
        }
      ],
      "destination": "https://blokapp.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/policy",
      "destination": "/en/privacy"
    },
    {
      "source": "/sv/policy",
      "destination": "/privacy"
    },
    {
      "source": "/:lang(en|da|de|el|es|fr|hr|it|hu|nl|no|pl|fi|tr|ar)/policy",
      "destination": "/:lang/privacy"
    }
  ]
}
